{
  "rules": {
    "users": {
      "$uid": {
        ".read": true,
        ".write": "auth !== null && auth.uid === $uid"
      }
    },
    "games": {
      ".read": true,
      "$gameId": {
        ".write": "auth !== null && (!data.exists() || data.child('ownerId').val() === auth.uid)"
      }
    },
    "maps": {
      "$gameId": {
        ".read": true,
        ".write": "auth !== null && root.child('games').child($gameId).child('ownerId').val() === auth.uid"
      }
    },
    "assets": {
      "$uid": {
        ".read": "auth !== null && auth.uid === $uid",
        ".write": "auth !== null && auth.uid === $uid"
      }
    }
  }
}
